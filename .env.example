PORT=4000
NODE_ENV=development
DB_PATH=./data/fairfair.sqlite
DATABASE_URL=
PG_POOL_MAX=2
PG_SSL_DISABLE=false

# Active V1 map provider (server-side only; see README.md "Active Geoapify Maps Setup")
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MAPS_PROVIDER=geoapify
GEOAPIFY_API_KEY=your_geoapify_api_key_here
GOOGLE_MAPS_DAILY_REQUEST_LIMIT=500
GOOGLE_MAPS_ENABLE_CACHE=true
FAIRFARE_MARKET_TIMEZONE=Asia/Karachi
FAIRFARE_RECOMMENDATION_THRESHOLD_PERCENT=10

# AI Ride Assistant (backend only; never expose provider keys to Expo)
AI_ASSISTANT_ENABLED=false
# Verified against Groq's official rate-limit/model docs on 2026-10-06.
# Free-plan base limits for GPT-OSS 120B/20B: 30 RPM, 1,000 RPD,
# 8,000 TPM, 200,000 TPD. Account limits may vary.
AI_PRIMARY_PROVIDER=gemini
GROQ_API_KEY=your_server_side_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=your_server_side_xai_api_key_here
XAI_MODEL=grok-4.7
# Optional comma-separated xAI models. If omitted, AI_MODEL_FALLBACKS is used.
XAI_FALLBACK_MODELS=
GEMINI_API_KEY=your_server_side_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=450
# AI providers (server-side only; never expose keys to the client)
AI_PROVIDER=openai-compatible
AI_MODEL=inclusionai/ling-3.1-flash
AI_REQUEST_TIMEOUT_MS=15000
AI_TOTAL_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1024
FAIRFARE_AI_SEARCH_LOCATIONS_TIMEOUT_MS=10000
AI_MAX_MODEL_ATTEMPTS=4
AI_MODEL_COOLDOWN_MS=30000
AI_MODEL_UNAVAILABLE_COOLDOWN_MS=300000
AI_MODEL_FALLBACK_ENABLED=false
AI_MODEL_FALLBACKS=
# Inkling Small is catalog-listed but rejected by OpenRouter for this normal
# chat contract (agentic-harness-only). Rerank/scoring models and coding-agent
# models are intentionally excluded from Ride Assistant generation.
FAIRFARE_COMPARISON_CONTEXT_TTL_MS=1800000

# Fair Fare authentication (required locally; use a long random value)
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
# Optional; defaults are used when omitted.
ACCESS_TOKEN_TTL=15m
# Sliding refresh-session lifetime; successful refresh extends it from use.
REFRESH_TOKEN_TTL_SECONDS=2592000

# OAuth/verification (backend-only; never EXPO_PUBLIC_*)
GOOGLE_OAUTH_CLIENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MOCK_VERIFICATION_PROVIDER=false

# Transactional email (backend-only; never expose to Expo)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Fair Fare <onboarding@example.com>
EMAIL_LOGO_URL=https://example.com/fair-fare-logo.png
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# inDrive: real mode requires an authorized session and configured fingerprints.
INDRIVE_ENABLED=true
INDRIVE_MODE=simulated
FAIRFARE_SIMULATION_ONLY=true
# Centralized runtime settings remain inactive until both flags are explicitly
# enabled. They never contain provider credentials.
PROVIDER_RUNTIME_CONFIG_ENABLED=false
PROVIDER_RUNTIME_CONFIG_ACTIVATED=false
PROVIDER_RUNTIME_CONFIG_LIVE_CUTOVER=false
PROVIDER_RUNTIME_CONFIG_REFRESH_MS=60000
FAIR_FARE_DATASET_MODE=legacy
# Comma-separated browser origins allowed to receive CORS headers. Leave empty
# for native mobile/no-Origin requests only; never use '*' with credentials.
FAIRFARE_ALLOWED_ORIGINS=
# Optional internal-only health diagnostics token; never expose it to clients.
HEALTH_DIAGNOSTICS_TOKEN=
# Exact reviewed approvals only; leave empty until evidence is reviewed.
# Format: City|internal-provider-id|vehicle,City|internal-provider-id|vehicle
FAIRFARE_APPROVED_COVERAGE=
FAIRFARE_PREDICTION_TIMEOUT_MS=3000
# inDrive access and refresh tokens are stored only in PostgreSQL provider_sessions.
# Use the secure local credential CLI; do not place either token in .env.
INDRIVE_DEVICE_FINGERPRINT=your_authorized_device_fingerprint_here
INDRIVE_FINGERPRINT=your_authorized_fingerprint_here
INDRIVE_APP_VERSION=android 5.157.0
INDRIVE_LANGUAGE=en_US
INDRIVE_OS_TYPE=android
INDRIVE_APP_FLAVOR=indriver
INDRIVE_REQUEST_TIMEOUT_MS=10000
INDRIVE_REFRESH_BUFFER_SECONDS=300

# Demo-only provider modes. quickride/urbancab are legacy internal IDs for
# Yango/Bykea in the existing database. Their REAL mode is intentionally not
# implemented; it reports unavailable instead of attempting provider auth.
# RouteStats remains disabled until Yango authorizes this server-side contract.
YANGO_ENABLED=false
YANGO_API_BASE_URL=https://tc.taxi.yango.tech
YANGO_ROUTE_STATS_PATH=/3.0/routestats
YANGO_AUTHORIZED_ACCESS_TOKEN=
YANGO_AUTHORIZED_CLIENT_ID=
YANGO_AUTHORIZATION_VERIFIED=false

# Optional provider-approved Yango test request context. Disabled by default;
# only used by non-production authorized-live requests when explicitly enabled.
PROVIDER_API_PAYLOAD_STORAGE_ENABLED=false
PROVIDER_API_PAYLOAD_RETENTION_DAYS=7
YANGO_TEST_REQUEST_ENABLED=false
YANGO_TEST_USER_ID=
YANGO_TEST_MOBILE_ID=
YANGO_TEST_LOCATION=
YANGO_TEST_MOBCF=
YANGO_TEST_MOBPR=
# YANGO_TEST_USER_ID -> body.id and X-Yataxi-Userid
# YANGO_TEST_MOBILE_ID -> X-Mob-Id
# YANGO_TEST_LOCATION=<latitude>;<longitude> -> X-Location and state.location
# YANGO_TEST_MOBCF -> mobcf query parameter
# YANGO_TEST_MOBPR -> mobpr query parameter
# When YANGO_TEST_REQUEST_ENABLED=true, the backend adds these fixed, non-sensitive
# test headers: X-Yataxi-Has-Ongoing-Orders=false,
# X-Yataxi-Ongoing-Orders-Statuses=none, X-Perf-Class=medium,
# Accept-Language=en-US, and X-Vpn-Active=0.
# No captured session, cookie, AppMetrica, device-fingerprint, or Android headers are generated.
YANGO_DEFAULT_ZONE=lahore
YANGO_DEFAULT_CLASS=econom
YANGO_DEFAULT_PAYMENT_TYPE=cash
YANGO_REQUEST_TIMEOUT_MS=10000
# Bykea is disabled until an authorized fare-estimate contract is supplied.
# BYKEA_MODE accepts simulated, authorized_live, or unavailable.
BYKEA_MODE=authorized_live
BYKEA_AUTHORIZED_LIVE=false
BYKEA_API_BASE_URL=
BYKEA_FARE_ENDPOINT=/talos/api/v3/users/estimation/fare
BYKEA_DEVICE_ID=
BYKEA_APP_USER_ID=
BYKEA_APP_USER_TOKEN=
BYKEA_APP_VERSION=
BYKEA_APP_LANGUAGE=en
BYKEA_APP_USER_TYPE=passenger
BYKEA_HEADER_LATITUDE=
BYKEA_HEADER_LONGITUDE=
BYKEA_HEADER_ALTITUDE=
BYKEA_USER_AGENT=
BYKEA_SERVICE_CODES=23,70,44,45,48
# Required by the authorized request contract; obtain exact values from Bykea.
BYKEA_REQUEST_TYPE=APP
BYKEA_VEHICLE_TYPE=
BYKEA_CURRENCY=PKR
BYKEA_CURRENCY_MULTIPLIER=1
BYKEA_REQUEST_TIMEOUT_MS=10000

# Backend-only current weather enrichment. Open-Meteo does not require a key.
FAIRFARE_WEATHER_ENABLED=true
FAIRFARE_WEATHER_TIMEOUT_MS=2500
FAIRFARE_AI_MODEL_FIRST_ENABLED=false
